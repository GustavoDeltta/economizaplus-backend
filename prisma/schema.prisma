// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  COMMON
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
}

enum CardType {
  CREDIT
  DEBIT
}

enum WalletType {
  CHECKING_ACCOUNT
  SAVINGS_ACCOUNT
  CASH
  INVESTMENT
  GOAL
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id                     String        @id @default(uuid())
  name                   String
  email                  String        @unique
  passwordHash           String
  role                   Role          @default(COMMON)
  authProvider           AuthProvider  @default(LOCAL)
  passwordResetCode      String?
  passwordResetExpiresAt DateTime?
  plan                   String        @default("BASIC")
  createdAt              DateTime      @default(now())

  wallets         Wallet[]
  categories      Category[]
  goals           Goal[]
  transactions    Transaction[]
  cards           Card[]
  contentProgress UserContentProgress[]
  aiGenerations   AIGeneration[]
  savings         Saving[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  color     String
  icon      String
  type      String   @default("custom")
  createdAt DateTime @default(now())

  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@map("categories")
}

model Goal {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  description        String
  walletId           String
  targetAmount       Decimal  @db.Decimal(15, 2)
  currentAmount      Decimal  @default(0) @db.Decimal(15, 2)
  percentageComplete Decimal  @default(0) @db.Decimal(15, 2)
  deadline           DateTime
  isCompleted        Boolean  @default(false)
  createdAt          DateTime @default(now())

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  savings      Saving[]

  @@map("goals")
}

model Card {
  id             String   @id @default(uuid())
  userId         String
  name           String
  brand          String
  last4Digits    String
  limitTotal     Decimal? @db.Decimal(15, 2)
  limitRemaining Decimal? @db.Decimal(15, 2)
  closingDay     Int?
  dueDay         Int?
  type           CardType
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, last4Digits])
  @@map("cards")
}

model Wallet {
  id        String     @id @default(uuid())
  userId    String
  name      String
  type      WalletType @default(CHECKING_ACCOUNT)
  balance   Decimal    @default(0) @db.Decimal(15, 2)
  createdAt DateTime   @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  savings      Saving[]
  goals        Goal[]

  @@map("wallets")
}

model Transaction {
  id                  String          @id @default(uuid())
  userId              String
  walletId            String
  categoryId          String?
  goal_id             String?
  cardId              String?
  type                TransactionType
  paymentMethod       PaymentMethod
  amount              Decimal         @db.Decimal(15, 2)
  description         String?
  transactionDate     DateTime
  isInstallment       Boolean         @default(false)
  installmentNumber   Int?
  totalInstallments   Int?
  parentTransactionId String?
  createdAt           DateTime        @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal              Goal?         @relation(fields: [goal_id], references: [id], onDelete: SetNull)
  card              Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  parentTransaction Transaction?  @relation("InstallmentGroup", fields: [parentTransactionId], references: [id])
  childTransactions Transaction[] @relation("InstallmentGroup")

  @@map("transactions")
}

model EducationalContent {
  id         String   @id @default(uuid())
  title      String
  category   String
  contentUrl String
  createdAt  DateTime @default(now())

  userProgress UserContentProgress[]

  @@map("educational_contents")
}

model AIGeneration {
  id        String   @id @default(uuid())
  userId    String
  response  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_generations")
}

model UserContentProgress {
  userId     String
  contentId  String
  accessedAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content EducationalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([userId, contentId])
  @@map("user_content_progress")
}

model Saving {
  id        String   @id @default(uuid())
  userId    String
  goalId    String
  walletId  String
  amount    Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("savings")
}
